#!/bin/bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# link-fuzz-target <compiler> <arguments>: the link of a fuzz target, a link whose arguments name
# $LIB_FUZZING_ENGINE. $CC and $CXX hand such a link here; build.sh never calls this itself.
#
# The link is made as the oss-fuzz-theorems 2026.10 release recipe makes it, whose binaries this reproduces
# byte for byte:
#
#     <compiler> -static -no-pie -Wl,--gc-sections <driver> [<silent reports>] <the link's own arguments> <seals>
#
# The driver (cli.o, adapter.o) comes first, in place of $LIB_FUZZING_ENGINE wherever the link named it, and the
# seals (getenv, mkstemp and getpid, each wrapped) come last: both positions change the bytes. A link that already
# wraps one of those functions has its own seals (a build ported from the release's recipe adds them where its pin
# did), and gets none added. In the AddressSanitizer builds, --defsym=__sanitizer_silent_reports=1 makes a detection
# abort without printing a report.
#
# It links twice: the output the link asked for, with its symbols, and the same link with --strip-all, saved under
# the sha256 of the first for compile to collect.
#
# A link that names $LIB_ALLOCATION_FAILURE_ENGINE makes an allocation-failure fuzz target (docs/build-contract.md):
# the same link, with allocation_failure.o in place of the adapter, and with copies of the object files and archives
# it names, whose calls of the allocators are renamed to allocation_failure.c's. Those are the only changes.
# $LIB_ALLOCATION_COUNTING_ENGINE makes the same, with counting mode on (allocation_counting.o), for sweep and test
# builds.
#
# A recipe that compiles its own adapter (rust/recipes.sh, with plugin_rust.h; python/recipes.sh, with
# python_tier_plugin.h) names it in OV_ADAPTER: it takes the place of adapter.o.
set -euo pipefail

# shellcheck source=/dev/null
. /tmp/ov/link.env

real=$1
shift
out=a.out
args=()
seals=$OV_SEALS
driver=$OV_DRIVER
while [ $# -gt 0 ]; do
  case "$1" in
    "$OV_LFE") ;;
    "$OV_AFE") driver=$OV_AF_DRIVER ;;
    "$OV_AFC") driver=$OV_AFC_DRIVER ;;
    -Wl,--wrap=getenv|-Wl,--wrap=getpid|-Wl,--wrap=mkstemp)
      seals=""
      args+=("$1") ;;
    -o)
      [ $# -ge 2 ] || { echo "link-fuzz-target: -o needs a file name" >&2; exit 1; }
      out=$2
      shift ;;
    -o?*) out=${1#-o} ;;
    *) args+=("$1") ;;
  esac
  shift
done

if [ -n "${OV_ADAPTER:-}" ]; then
  [ "$driver" = "$OV_DRIVER" ] || { echo "link-fuzz-target: a fuzz target with its own adapter has no allocation-failure form" >&2; exit 1; }
  driver="$OV_CLI $OV_ADAPTER"
fi

if [ "$driver" = "$OV_AF_DRIVER" ] || [ "$driver" = "$OV_AFC_DRIVER" ]; then
  copies=$(mktemp -d /tmp/ov/af.XXXXXX)
  for i in "${!args[@]}"; do
    a=${args[$i]}
    case "$a" in
      # --for-linker is clang's other spelling of -Xlinker, and a --config file can hold -L, -l and -Wl options.
      -l*|-Wl,*|-Xlinker|--for-linker|--for-linker=*|--config|--config=*)
        echo "link-fuzz-target: $a: name an allocation-failure fuzz target's object files and archives directly, without -l, linker forwarding or a configuration file" >&2
        exit 1 ;;
      -*) continue ;;
      @*)
        echo "link-fuzz-target: $a: name an allocation-failure fuzz target's objects on the command line" >&2
        exit 1 ;;
      *.c|*.cc|*.cpp|*.cxx|*.c++|*.C|*.m|*.mm|*.s|*.S)
        echo "link-fuzz-target: $a: compile an allocation-failure fuzz target's sources first, and link the objects" >&2
        exit 1 ;;
    esac
    [ -f "$a" ] || continue
    case "$(head -c 4 -- "$a")" in
      $'\177ELF'|'!<ar') ;;
      'BC'$'\300\336')
        echo "link-fuzz-target: $a: LLVM bitcode; an allocation-failure fuzz target needs object code (no LTO)" >&2
        exit 1 ;;
      *)
        echo "link-fuzz-target: $a: an allocation-failure fuzz target needs object files and archives, not linker scripts or other inputs" >&2
        exit 1 ;;
    esac
    copy="$copies/$i-$(basename -- "$a")"
    cp -- "$a" "$copy"
    # shellcheck disable=SC2086 # a list of options
    llvm-objcopy $OV_AF_RENAME "$copy"
    args[i]=$copy
  done
fi

link() {
  # shellcheck disable=SC2086 # the lists in link.env are meant to be split
  $real -static -no-pie -Wl,--gc-sections "$@" $driver $OV_SILENT_LD ${args[@]+"${args[@]}"} $seals
}

link -o "$out"
sum=$(sha256sum "$out" | cut -d' ' -f1)
link -Wl,--strip-all -o "$OV_TWINS/$sum.tmp"
mv -f "$OV_TWINS/$sum.tmp" "$OV_TWINS/$sum"
